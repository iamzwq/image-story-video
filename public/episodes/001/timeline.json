  "captions": [
    {
      "text": "大年夜，天气冷极了",
      "start": 0.0,
      "end": 2.065
    },
    {
      "text": "天空飘着鹅毛大雪",
      "start": 2.065,
      "end": 4.104
    },
    {
      "text": "一个小女孩光着脚",
      "start": 4.104,
      "end": 5.74
    },
    {
      "text": "走在冰冷的大街上",
      "start": 5.74,
      "end": 7.75
    },
    {
      "text": "她穿着一件破旧的衣服",
      "start": 7.75,
      "end": 9.738
    },
    {
      "text": "手里拿着一把火柴",
      "start": 9.738,
      "end": 11.83
    },
    {
      "text": "她不敢回家",
      "start": 11.83,
      "end": 12.964
    },
    {
      "text": "因为今天一根火柴也没有卖出去",
      "start": 12.964,
      "end": 15.583
    },
    {
      "text": "爸爸一定会打她",
      "start": 15.583,
      "end": 17.236
    },
    {
      "text": "街上的人们都在忙着过年",
      "start": 17.236,
      "end": 19.585
    },
    {
      "text": "家家户户灯火通明",
      "start": 19.585,
      "end": 21.382
    },
    {
      "text": "飘出烤鹅的香味",
      "start": 21.382,
      "end": 23.32
    },
    {
      "text": "小女孩又冷又饿",
      "start": 23.32,
      "end": 24.895
    },
    {
      "text": "蜷缩在墙角",
      "start": 24.895,
      "end": 26.24
    },
    {
      "text": "终于忍不住擦亮了一根火柴",
      "start": 26.24,
      "end": 28.874
    },
    {
      "text": "火光亮起来了",
      "start": 28.874,
      "end": 30.206
    },
    {
      "text": "她仿佛看见一只热气腾腾的烤鹅",
      "start": 30.206,
      "end": 32.861
    },
    {
      "text": "正向她走来",
      "start": 32.861,
      "end": 34.476
    },
    {
      "text": "火柴熄灭了",
      "start": 34.476,
      "end": 35.602
    },
    {
      "text": "烤鹅也消失了",
      "start": 35.602,
      "end": 37.198
    },
    {
      "text": "她又擦亮一根火柴",
      "start": 37.198,
      "end": 39.274
    },
    {
      "text": "这一次，她看见了一棵漂亮的圣诞树",
      "start": 39.274,
      "end": 42.434
    },
    {
      "text": "上面挂满了蜡烛和彩灯",
      "start": 42.434,
      "end": 44.704
    },
    {
      "text": "她伸出手，想要触摸那些光芒",
      "start": 44.704,
      "end": 47.338
    },
    {
      "text": "可火柴很快又熄灭了",
      "start": 47.338,
      "end": 49.646
    },
    {
      "text": "接着，她擦亮了第三根火柴",
      "start": 49.646,
      "end": 52.374
    },
    {
      "text": "这一次，她看见了最疼爱她的奶奶",
      "start": 52.374,
      "end": 55.476
    },
    {
      "text": "奶奶微笑着",
      "start": 55.476,
      "end": 56.694
    },
    {
      "text": "张开双臂",
      "start": 56.694,
      "end": 58.176
    },
    {
      "text": "小女孩赶紧擦亮手中剩下的火柴",
      "start": 58.176,
      "end": 61.191
    },
    {
      "text": "生怕奶奶再次消失",
      "start": 61.191,
      "end": 63.242
    },
    {
      "text": "火光越来越亮",
      "start": 63.242,
      "end": 64.586
    },
    {
      "text": "奶奶也越来越温暖",
      "start": 64.586,
      "end": 66.622
    },
    {
      "text": "奶奶抱起小女孩",
      "start": 66.622,
      "end": 68.125
    },
    {
      "text": "带着她飞向天空",
      "start": 68.125,
      "end": 69.697
    },
    {
      "text": "飞向没有寒冷",
      "start": 69.697,
      "end": 70.959
    },
    {
      "text": "没有饥饿，也没有痛苦的地方",
      "start": 70.959,
      "end": 73.824
    },
    {
      "text": "第二天清晨",
      "start": 73.824,
      "end": 75.055
    },
    {
      "text": "人们发现了墙角的小女孩",
      "start": 75.055,
      "end": 77.434
    },
    {
      "text": "她已经冻死了",
      "start": 77.434,
      "end": 78.767
    },
    {
      "text": "脸上却带着微笑",
      "start": 78.767,
      "end": 80.67
    },
    {
      "text": "谁也不知道",
      "start": 80.67,
      "end": 81.816
    },
    {
      "text": "在那个寒冷的夜晚",
      "start": 81.816,
      "end": 83.4
    },
    {
      "text": "她曾经看见过多么美好的世界",
      "start": 83.4,
      "end": 86.004
    }
  ],
  "lines": [
    {
      "scene": "S01",
      "text": "大年夜，天气冷极了，天空飘着鹅毛大雪。",
      "start": 0.0,
      "end": 3.754
    },
    {
      "scene": "S01",
      "text": "一个小女孩光着脚，走在冰冷的大街上。她穿着一件破旧的衣服，手里拿着一把火柴。",
      "start": 4.104,
      "end": 11.33
    },
    {
      "scene": "S02",
      "text": "她不敢回家，因为今天一根火柴也没有卖出去，爸爸一定会打她。",
      "start": 11.83,
      "end": 16.886
    },
    {
      "scene": "S02",
      "text": "街上的人们都在忙着过年，家家户户灯火通明，飘出烤鹅的香味。",
      "start": 17.236,
      "end": 22.82
    },
    {
      "scene": "S03",
      "text": "小女孩又冷又饿，蜷缩在墙角，终于忍不住擦亮了一根火柴。",
      "start": 23.32,
      "end": 28.524
    },
    {
      "scene": "S03",
      "text": "火光亮起来了，她仿佛看见一只热气腾腾的烤鹅，正向她走来。",
      "start": 28.874,
      "end": 33.976
    },
    {
      "scene": "S04",
      "text": "火柴熄灭了，烤鹅也消失了。",
      "start": 34.476,
      "end": 36.848
    },
    {
      "scene": "S04",
      "text": "她又擦亮一根火柴。",
      "start": 37.198,
      "end": 38.774
    },
    {
      "scene": "S05",
      "text": "这一次，她看见了一棵漂亮的圣诞树，上面挂满了蜡烛和彩灯。",
      "start": 39.274,
      "end": 44.354
    },
    {
      "scene": "S05",
      "text": "她伸出手，想要触摸那些光芒，可火柴很快又熄灭了。",
      "start": 44.704,
      "end": 49.146
    },
    {
      "scene": "S06",
      "text": "接着，她擦亮了第三根火柴。",
      "start": 49.646,
      "end": 52.024
    },
    {
      "scene": "S06",
      "text": "这一次，她看见了最疼爱她的奶奶。",
      "start": 52.374,
      "end": 55.126
    },
    {
      "scene": "S06",
      "text": "奶奶微笑着，张开双臂。",
      "start": 55.476,
      "end": 57.676
    },
    {
      "scene": "S07",
      "text": "小女孩赶紧擦亮手中剩下的火柴，生怕奶奶再次消失。",
      "start": 58.176,
      "end": 62.892
    },
    {
      "scene": "S07",
      "text": "火光越来越亮，奶奶也越来越温暖。",
      "start": 63.242,
      "end": 66.122
    },
    {
      "scene": "S08",
      "text": "奶奶抱起小女孩，带着她飞向天空，飞向没有寒冷、没有饥饿，也没有痛苦的地方。",
      "start": 66.622,
      "end": 73.324
    },
    {
      "scene": "S09",
      "text": "第二天清晨，人们发现了墙角的小女孩。她已经冻死了，脸上却带着微笑。",
      "start": 73.824,
      "end": 80.17
    },
    {
      "scene": "S10",
      "text": "谁也不知道，在那个寒冷的夜晚，她曾经看见过多么美好的世界。",
      "start": 80.67,
      "end": 86.004
    }
  ]
}
