# 复制本文件并改名为 .env，再填写需要用到的项。
# .env 只保存在你自己的电脑上（已加入 .gitignore），不要把密钥发给别人或贴到聊天里。
# 只有 npm run make、storyboard、images 会读取 .env；预览和导出读取的是 remotion.env，不会碰到这里的密钥。

# ========== 大模型：写分镜（make、storyboard），以及出图被审核拦下时改写提示词 ==========
# 任何兼容 OpenAI 协议的服务都可以，三项都要填。例如：
#   DeepSeek      LLM_BASE_URL=https://api.deepseek.com                            LLM_MODEL=deepseek-flash
#                 （Key 在 https://platform.deepseek.com/api_keys 创建）
#   阿里云百炼    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#                 （和下面的 DASHSCOPE_API_KEY 是同一个 Key）
#   火山引擎方舟  LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3            LLM_MODEL=doubao-seed-2-1-lite-260915
#                 （方舟 API Key，模型要先在控制台开通）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ========== 生图（make、images） ==========
# 两个平台都配置了 Key 时，默认用哪个：bailian 或 ark（运行时也可以用 --provider 临时指定）
IMAGE_PROVIDER=

# 阿里云百炼（千问生图 / Z-Image）
#   在百炼控制台 https://bailian.console.aliyun.com 开通服务并创建 API Key
#   说明文档：https://help.aliyun.com/zh/model-studio/get-api-key
#   模型可选 z-image-turbo（约 0.1 元/张，北京地域开通后 90 天内免费 100 张）、
#   qwen-image-3.0（0.18 元/张）、qwen-image-3.0-pro（千问旗舰，0.25 元/张）、qwen-image-2.1-turbo 等，
#   不确定选哪个，可以先运行 npm run images -- 001 --compare z-image-turbo,qwen-image-3.0 对比
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=z-image-turbo
#   接口地址已内置为北京地域（https://dashscope.aliyuncs.com），一般不用填。用新加坡地域
#   （https://dashscope-intl.aliyuncs.com，需要新加坡地域的 Key）或百炼的业务空间专属域名时才需要改：
# DASHSCOPE_BASE_URL=

# 火山引擎方舟（Seedream，即梦/豆包同款模型）
#   先在 https://ark.volcengine.com/region:cn-beijing/openManagement 开通 Seedream 模型，
#   再在 https://ark.volcengine.com/region:cn-beijing/apiKey 创建 API Key
#   模型可选 doubao-seedream-5-5-261028（约 0.13 元/张）等
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-5-261028
#   接口地址已内置为北京地域（https://ark.cn-beijing.volces.com/api/v3），一般不用填：
# ARK_BASE_URL=
